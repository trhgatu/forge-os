generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User { 
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  password        String
  refreshToken    String?
  roleId          String?
  role            Role?            @relation(fields: [roleId], references: [id])
  stats           UserStats?
  connections     UserConnection[]
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?
  journals        Journal[]
  habits          Habit[]
  routines        Routine[]
  quests          Quest[]
  questStatuses   UserQuestStatus[]
  tasks           Task[]
  goals           Goal[]
  goalStatuses    UserGoalStatus[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("users")
}

model UserConnection {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String   // e.g., 'github', 'google'
  identifier  String   // e.g., 'thuyencode', '10238129'
  metadata    Json?
  connectedAt DateTime @default(now())

  @@unique([provider, identifier])
  @@map("user_connections")
}

model UserStats {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp               Int      @default(0)
  level            Int      @default(1)
  title            String   @default("Novice")
  streak           Int      @default(0)
  lastActivityDate DateTime @default(now())
  achievements     String[] @default([])

  @@map("user_stats")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  users       User[]
  permissions Permission[] @relation("RolePermissions")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  resource    String
  action      String
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  roles       Role[]    @relation("RolePermissions")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("permissions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  method     String?
  statusCode Int?
  path       String?
  params     Json?
  query      Json?
  body       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model Project {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      String    @default("active")
  tags        String[]  @default([])
  isPinned    Boolean   @default(false)
  progress    Int       @default(0)
  githubStats Json?
  taskBoard   Json?
  links       Json?     @default("[]")
  logs        Json?     @default("[]")
  metadata    Json?     @default("{}")
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("projects")
}

model Journal {
  id        String    @id @default(uuid())
  title     String?
  content   String
  mood      String?
  tags      String[]  @default([])
  type      String    @default("thought")
  status    String    @default("private")
  source    String    @default("user")
  relations Json?     @default("[]")
  analysis  Json?
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("journals")
}

model Memory {
  id        String    @id @default(uuid())
  title     Json      @default("{}")
  content   Json      @default("{}")
  mood      String?
  tags      String[]  @default([])
  status    String    @default("internal")
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("memories")
}

model Mood {
  id        String    @id @default(uuid())
  mood      String
  note      String?
  intensity Int?
  tags      String[]  @default([])
  loggedAt  DateTime  @default(now())
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("moods")
}

model Quote {
  id          String       @id @default(uuid())
  content     Json         @default("{}")
  author      String?
  source      String?
  tags        String[]     @default([])
  mood        String?
  status      String       @default("internal")
  isDeleted   Boolean      @default(false)
  deletedAt   DateTime?
  dailyQuotes DailyQuote[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("quotes")
}

model DailyQuote {
  id        String   @id @default(uuid())
  date      String   @unique // Format: YYYY-MM-DD
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_quotes")
}

// ==========================================
// HABITS CONTEXT (Bối cảnh Thói Quen Dài Hạn)
// ==========================================
model Habit {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  xpReward       Int               @default(10)
  difficulty     String            @default("easy")   // 'easy', 'medium', 'hard'
  frequency      Json              // Lịch biểu: {"days": [1,3,5]} (Thứ 2-4-6) hoặc {"every": 1} (mỗi ngày)
  streak         Int               @default(0)
  maxStreak      Int               @default(0)
  habitStrength  Int               @default(0)        // Chỉ số độ bền thói quen (0 - 100)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  routines       RoutineHabit[]
  completions    HabitCompletion[]

  @@map("habits")
}

model HabitCompletion {
  id          String   @id @default(uuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId      String
  completedAt DateTime @default(now())

  @@map("habit_completions")
}

// ==========================================
// ROUTINES CONTEXT (Bối cảnh Chuỗi Nghi Thức)
// ==========================================
model Routine {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String         // Ví dụ: "Morning Routine"
  comboXp     Int            @default(20)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  habits      RoutineHabit[]

  @@map("routines")
}

model RoutineHabit {
  id        String  @id @default(uuid())
  routineId String
  routine   Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  habitId   String
  habit     Habit   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  order     Int     // Thứ tự thực hiện: 1, 2, 3...

  @@unique([routineId, habitId])
  @@map("routine_habits")
}

// ==========================================
// QUESTS CONTEXT (Hệ thống Nhiệm vụ Đa hình)
// ==========================================
model Quest {
  id           String              @id @default(uuid())
  userId       String?             // Nullable: null đại diện cho Global System Quest; String = Custom User Quest
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String              // ví dụ: "Trang sử hoàng hôn"
  description  String?             // ví dụ: "Viết 1 trang nhật ký để phản tỉnh ngày hôm nay"
  type         String              @default("daily")      // 'daily', 'weekly', 'main', 'side'
  xpReward     Int                 @default(15)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  
  objectives   QuestObjective[]
  userStatuses UserQuestStatus[]

  @@map("quests")
}

model QuestObjective {
  id            String                  @id @default(uuid())
  questId       String
  quest         Quest                   @relation(fields: [questId], references: [id], onDelete: Cascade)
  type          String                  // Loại hành động: 'CREATE_JOURNAL', 'COMPLETE_PROJECT', 'CHECK_HABIT', 'CREATE_MEMORY'
  targetCount   Int                     @default(1)
  referenceType String                  // Tên thực thể đích: 'Journal', 'Project', 'Memory', 'Habit'
  referenceId   String?                 // UUID cụ thể của thực thể đích (nếu trỏ đích danh)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  userProgress  UserObjectiveProgress[]

  @@map("quest_objectives")
}

model UserQuestStatus {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest       @relation(fields: [questId], references: [id], onDelete: Cascade)
  status      String      @default("active")     // 'locked', 'active', 'completed'
  startedAt   DateTime    @default(now())
  completedAt DateTime?

  @@unique([userId, questId])
  @@map("user_quest_statuses")
}

model UserObjectiveProgress {
  id           String         @id @default(uuid())
  userId       String
  objectiveId  String
  objective    QuestObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  currentCount Int            @default(0)
  isCompleted  Boolean        @default(false)
  date         String?        // YYYY-MM-DD (Chỉ dùng cho Daily Quests để reset tiến trình mỗi ngày)
  updatedAt    DateTime       @updatedAt

  @@unique([userId, objectiveId, date])
  @@map("user_objective_progress")
}

model Task {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String    @default("todo")        // 'todo', 'in_progress', 'done'
  priority    String    @default("medium")      // 'low', 'medium', 'high'
  xpReward    Int       @default(15)
  dueDate     DateTime?
  completedAt DateTime?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("tasks")
}

model Goal {
  id           String            @id @default(uuid())
  userId       String?           // Nullable: null đại diện cho Global System Goals; String = Custom User Goal
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String            // ví dụ: "Master of Reality" (Bậc Thầy Thực Tại)
  description  String?           // ví dụ: "Chinh phục thế giới thực tại Stoic bằng cách hoàn tất 10 Meta-Quests"
  xpReward     Int               @default(1000)
  badgeIcon    String?           // Mã Achievement (ví dụ: 'achievement_master_of_reality')
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  objectives   GoalObjective[]
  userStatuses UserGoalStatus[]

  @@map("goals")
}

model GoalObjective {
  id            String                @id @default(uuid())
  goalId        String
  goal          Goal                  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  type          String                // Loại hành động: 'COMPLETE_META_QUEST', 'COMPLETE_DAILY_QUEST'
  targetCount   Int                   @default(10)
  referenceId   String?               // UUID cụ thể của Quest Lớn/Nhỏ (nếu trỏ đích danh)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  userProgress  UserGoalProgress[]

  @@map("quest_goal_objectives")
}

model UserGoalStatus {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId      String
  goal        Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  status      String      @default("active")     // 'locked', 'active', 'completed'
  startedAt   DateTime    @default(now())
  completedAt DateTime?

  @@unique([userId, goalId])
  @@map("user_goal_statuses")
}

model UserGoalProgress {
  id           String         @id @default(uuid())
  userId       String
  objectiveId  String
  objective    GoalObjective  @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  currentCount Int            @default(0)
  isCompleted  Boolean        @default(false)
  updatedAt    DateTime       @updatedAt

  @@unique([userId, objectiveId])
  @@map("user_goal_progress")
}
