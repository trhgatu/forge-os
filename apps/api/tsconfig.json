{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2023",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "strict": true,
    "paths": {
      "@config/*": [
        "src/config/*"
      ],
      "@contexts/*": [
        "src/contexts/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@gateway/*": [
        "src/gateway/*"
      ],
      "@scripts/*": [
        "src/scripts/*"
      ],
      "@root/*": [
        "src/*"
      ],
      "@forge/core": [
        "../../packages/core/src/index"
      ],
      "@forge/auth": [
        "../../packages/auth/src/index"
      ],
      "@forge/reflection": [
        "../../packages/reflection/src/index"
      ]
    },
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}